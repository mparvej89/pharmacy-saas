# =============================================================================
# Pharmacy SaaS Environment Configuration (Template)
# =============================================================================
# Copy this file to .env and configure with your actual Neon PostgreSQL URL.
# NEVER commit your actual .env file or credentials to Git.

# Neon PostgreSQL Pooled Connection String (TLS required)
# Database name: pharmacy_db
DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@ep-your-project-pooler.region.aws.neon.tech/pharmacy_db?sslmode=require&connect_timeout=15&pool_timeout=15&connection_limit=10"

# Optional: Neon Direct Connection String for Prisma CLI Migrations (unpooled)
# DIRECT_URL="postgresql://DB_USER:DB_PASSWORD@ep-your-project.region.aws.neon.tech/pharmacy_db?sslmode=require&connect_timeout=15"

# Server Configuration
PORT=3000
NODE_ENV=development

# Authentication
JWT_SECRET="replace-with-a-strong-random-jwt-secret-in-production"
JWT_EXPIRES_IN="7d"

# Database Pool & Timeout Settings (ms)
DB_CONNECT_TIMEOUT_MS=15000
DB_TRANSACTION_TIMEOUT_MS=15000
DB_MAX_WAIT_MS=5000

# Frontend Origin for CORS
CORS_ORIGIN="http://localhost:4200,http://localhost:8100"
